# Chave do Google AI Studio para os modelos Gemini usados pelos agentes.
GOOGLE_API_KEY=

# Modelo Gemini usado por todos os agentes. Ajuste conforme os modelos
# disponiveis e os limites ativos no seu projeto do Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Caminho do arquivo SQLite usado para persistir sessoes do ADK e os dados
# de reservas/visitantes do condominio.
DATABASE_URL=sqlite:///./data/aurora.db

# Porta em que a API responde (padrao exigido: 8000).
PORT=8000
